{
    "name": "phpinnacle/dendros",
    "description": "A plugin for Laravel Filament to handle tree structures.",
    "keywords": [
        "phpinnacle",
        "laravel",
        "filament"
    ],
    "homepage": "https://github.com/phpinnacle/dendros",
    "support": {
        "issues": "https://github.com/phpinnacle/dendros/issues",
        "source": "https://github.com/phpinnacle/dendros"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "PHPinnacle Devs",
            "email": "dev@phpinnacle.edu.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "codewithdennis/filament-select-tree": "^4.0",
        "kisame76/filament-tree-table": "^1.3",
        "spatie/laravel-package-tools": "^1.92"
    },
    "autoload": {
        "psr-4": {
            "PHPinnacle\\Dendros\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "PHPinnacle\\Dendros\\DendrosServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
