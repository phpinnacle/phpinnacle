{
    "name": "phpinnacle/rosetta",
    "description": "Read and map 1C:Enterprise infobase metadata without framework dependencies.",
    "keywords": [
        "phpinnacle",
        "1c",
        "infobase",
        "metadata",
        "parser"
    ],
    "homepage": "https://github.com/phpinnacle/rosetta",
    "support": {
        "issues": "https://github.com/phpinnacle/rosetta/issues",
        "source": "https://github.com/phpinnacle/rosetta"
    },
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "PHPinnacle Devs",
            "email": "dev@phpinnacle.edu.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "ext-pdo": "*",
        "ext-zlib": "*",
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "PHPinnacle\\Rosetta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PHPinnacle\\Rosetta\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --no-coverage"
    },
    "extra": {"branch-alias": {"dev-master": "1.x-dev"}},
    "prefer-stable": true
}
