{
    "name": "phpinnacle/settings",
    "description": "Registry-driven application settings and user preferences for Laravel Filament.",
    "keywords": [
        "phpinnacle",
        "laravel",
        "filament"
    ],
    "homepage": "https://github.com/phpinnacle/settings",
    "support": {
        "issues": "https://github.com/phpinnacle/settings/issues",
        "source": "https://github.com/phpinnacle/settings"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "PHPinnacle Devs",
            "email": "dev@phpinnacle.edu.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "autoload": {
        "psr-4": {
            "PHPinnacle\\Settings\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "PHPinnacle\\Settings\\SettingsServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
