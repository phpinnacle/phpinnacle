{
    "name": "phpinnacle/palette",
    "description": "Color palette utilities for Laravel Filament applications.",
    "keywords": [
        "phpinnacle",
        "filament",
        "color",
        "palette"
    ],
    "homepage": "https://github.com/phpinnacle/palette",
    "support": {
        "issues": "https://github.com/phpinnacle/palette/issues",
        "source": "https://github.com/phpinnacle/palette"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "PHPinnacle Devs",
            "email": "dev@phpinnacle.edu.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/forms": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.92",
        "spatie/color": "^1.8"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "PHPinnacle\\Palette\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest --no-coverage"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "PHPinnacle\\Palette\\PaletteServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
