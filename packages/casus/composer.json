{
    "name": "phpinnacle/casus",
    "description": "A plugin for Laravel Filament that adds error tracking to your application.",
    "keywords": [
        "phpinnacle",
        "laravel",
        "filament"
    ],
    "homepage": "https://github.com/phpinnacle/casus",
    "support": {
        "issues": "https://github.com/phpinnacle/casus/issues",
        "source": "https://github.com/phpinnacle/casus"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "PHPinnacle Devs",
            "email": "dev@phpinnacle.edu.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^4.0|^5.0",
        "phiki/phiki": "^2.2",
        "phpinnacle/tempo": "^1.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "autoload": {
        "psr-4": {
            "PHPinnacle\\Casus\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "PHPinnacle\\Casus\\CasusServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
