{
    "name": "phpinnacle/cerber",
    "description": "Authentication and authorization management for Laravel Filament applications.",
    "keywords": [
        "phpinnacle",
        "laravel",
        "filament"
    ],
    "homepage": "https://github.com/phpinnacle/cerber",
    "support": {
        "issues": "https://github.com/phpinnacle/cerber/issues",
        "source": "https://github.com/phpinnacle/cerber"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "PHPinnacle Devs",
            "email": "dev@phpinnacle.edu.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^4.0|^5.0",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.0",
        "phpinnacle/common": "^1.0",
        "phpinnacle/tempo": "^1.0",
        "socialiteproviders/yandex": "^4.1",
        "spatie/laravel-package-tools": "^1.92"
    },
    "autoload": {
        "psr-4": {
            "PHPinnacle\\Cerber\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "PHPinnacle\\Cerber\\CerberServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
