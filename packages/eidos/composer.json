{
    "name": "phpinnacle/eidos",
    "description": "JSON Schema generation, Laravel validation, and reusable Filament mapping, binding, and schema fields.",
    "keywords": [
        "phpinnacle",
        "laravel",
        "eloquent",
        "json-schema"
    ],
    "homepage": "https://github.com/phpinnacle/eidos",
    "support": {
        "issues": "https://github.com/phpinnacle/eidos/issues",
        "source": "https://github.com/phpinnacle/eidos"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "PHPinnacle Devs",
            "email": "dev@phpinnacle.edu.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "filament/filament": "^4.0|^5.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0",
        "php": "^8.4",
        "phpinnacle/jason": "^1.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "PHPinnacle\\Eidos\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest --no-coverage"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "PHPinnacle\\Eidos\\EidosServiceProvider"
            ]
        }
    },
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
