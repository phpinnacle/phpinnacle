{
    "name": "phpinnacle/iconic",
    "description": "Searchable icon picker and Phosphor icon integration for Laravel Filament.",
    "keywords": ["phpinnacle", "laravel", "filament", "icons", "phosphor"],
    "homepage": "https://github.com/phpinnacle/iconic",
    "support": {
        "issues": "https://github.com/phpinnacle/iconic/issues",
        "source": "https://github.com/phpinnacle/iconic"
    },
    "license": "MIT",
    "authors": [{"name": "PHPinnacle Devs", "email": "dev@phpinnacle.edu.pl", "role": "Developer"}],
    "require": {
        "php": "^8.4",
        "codeat3/blade-phosphor-icons": "^2.4",
        "filament/filament": "^4.0|^5.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0"
    },
    "autoload": {"psr-4": {"PHPinnacle\\Iconic\\": "src/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "config": {
        "allow-plugins": {"pestphp/pest-plugin": true},
        "sort-packages": true
    },
    "scripts": {"test": "pest --no-coverage"},
    "extra": {"branch-alias": {"dev-master": "1.x-dev"}, "laravel": {"providers": ["PHPinnacle\\Iconic\\IconicServiceProvider"]}},
    "prefer-stable": true
}
