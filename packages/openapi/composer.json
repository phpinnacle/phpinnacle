{
    "name": "phpinnacle/openapi",
    "description": "OpenAPI schema conversion to Laravel validation rules.",
    "keywords": [
        "phpinnacle",
        "laravel",
        "filament"
    ],
    "homepage": "https://github.com/phpinnacle/openapi",
    "support": {
        "issues": "https://github.com/phpinnacle/openapi/issues",
        "source": "https://github.com/phpinnacle/openapi"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "PHPinnacle Devs",
            "email": "dev@phpinnacle.edu.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "darkaonline/l5-swagger": "^11.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "PHPinnacle\\OpenApi\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest --no-coverage"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "PHPinnacle\\OpenApi\\OpenApiServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
