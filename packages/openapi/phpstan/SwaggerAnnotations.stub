<?php

namespace OpenApi\Annotations;

trait JsonSchemaTrait
{
    /** @var int|string */
    public $minLength;

    /** @var int|string */
    public $maxLength;

    /** @var int|float|string */
    public $minimum;

    /** @var int|float|string */
    public $maximum;

    /** @var list<string|int|float|bool|\UnitEnum>|class-string|string */
    public $enum;
}

class Schema
{
    /** @var list<object>|string */
    public $properties;

    /** @var array<Schema>|string */
    public $allOf;
}
