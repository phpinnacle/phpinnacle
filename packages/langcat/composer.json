{
    "name": "phpinnacle/langcat",
    "type": "library",
    "description": "Framework-agnostic PHP client for the LangLion API.",
    "keywords": [
        "phpinnacle",
        "langlion",
        "crm",
        "api"
    ],
    "homepage": "https://github.com/phpinnacle/langcat",
    "support": {
        "issues": "https://github.com/phpinnacle/langcat/issues",
        "source": "https://github.com/phpinnacle/langcat"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "PHPinnacle Devs",
            "email": "dev@phpinnacle.edu.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "PHPinnacle\\Langcat\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true
}
