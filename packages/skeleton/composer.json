{
    "name": "phpinnacle/skeleton",
    "description": "A plugin for Laravel Filament that adds skeleton to your application.",
    "keywords": [
        "phpinnacle",
        "laravel",
        "filament"
    ],
    "homepage": "https://github.com/phpinnacle/skeleton",
    "support": {
        "issues": "https://github.com/phpinnacle/skeleton/issues",
        "source": "https://github.com/phpinnacle/skeleton"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "PHPinnacle Devs",
            "email": "dev@phpinnacle.edu.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.92"
    },
    "autoload": {
        "psr-4": {
            "PHPinnacle\\Skeleton\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "PHPinnacle\\Skeleton\\SkeletonServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
