#!/usr/bin/env php
<?php

declare(strict_types=1);

use Mago\Sdk\Worker;
use PHPinnacle\Grimoire\GrimoireExtension;

$autoload = $_composer_autoload_path ?? dirname(__DIR__) . '/vendor/autoload.php';

if (! is_file($autoload)) {
    $autoload = dirname(__DIR__, 3) . '/vendor/autoload.php';
}

require $autoload;

/** @var array{rules?: array{class-member-order?: list<array{extends?: string, order: list<string>}>, class-method-order?: list<array{extends?: string, order: list<string>}>, compact-empty-method-body?: array{method-pattern?: string}}} $configuration */
$configuration = isset($argv[1])
    ? json_decode(file_get_contents($argv[1]), true, flags: JSON_THROW_ON_ERROR)
    : [];

new Worker(GrimoireExtension::create($configuration))->run();
