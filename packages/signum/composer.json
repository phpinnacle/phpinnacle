{
    "name": "phpinnacle/signum",
    "description": "A plugin for Laravel Filament that adds signum to your application.",
    "keywords": [
        "phpinnacle",
        "laravel",
        "filament"
    ],
    "homepage": "https://github.com/phpinnacle/signum",
    "support": {
        "issues": "https://github.com/phpinnacle/signum/issues",
        "source": "https://github.com/phpinnacle/signum"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "PHPinnacle Devs",
            "email": "dev@phpinnacle.edu.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/laravel-package-tools": "^1.92"
    },
    "autoload": {
        "psr-4": {
            "PHPinnacle\\Signum\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "PHPinnacle\\Signum\\SignumServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
