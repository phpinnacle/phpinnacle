{
    "name": "phpinnacle/chronica",
    "description": "A plugin for Laravel Filament that adds chronica to your application.",
    "keywords": [
        "phpinnacle",
        "laravel",
        "filament"
    ],
    "homepage": "https://github.com/phpinnacle/chronica",
    "support": {
        "issues": "https://github.com/phpinnacle/chronica/issues",
        "source": "https://github.com/phpinnacle/chronica"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "PHPinnacle Devs",
            "email": "dev@phpinnacle.edu.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^4.0|^5.0",
        "spatie/laravel-activitylog": "^5.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "autoload": {
        "psr-4": {
            "PHPinnacle\\Chronica\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "PHPinnacle\\Chronica\\ChronicaServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
