{
    "name": "phpinnacle/razor",
    "description": "Template-driven document generation for Laravel Filament.",
    "keywords": [
        "phpinnacle",
        "laravel",
        "filament"
    ],
    "homepage": "https://github.com/phpinnacle/razor",
    "support": {
        "issues": "https://github.com/phpinnacle/razor/issues",
        "source": "https://github.com/phpinnacle/razor"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "PHPinnacle Devs",
            "email": "dev@phpinnacle.edu.pl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "phpinnacle/common": "^1.0",
        "phpinnacle/money": "^1.0",
        "phpinnacle/sequentia": "^1.0",
        "phpinnacle/tempo": "^1.0",
        "spatie/laravel-package-tools": "^1.92",
        "twig/twig": "^3.21",
        "twig/intl-extra": "^3.21",
        "zordius/lightncandy": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "PHPinnacle\\Razor\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "PHPinnacle\\Razor\\RazorServiceProvider"
            ]
        }
    },
    "prefer-stable": true
}
