{
    "name": "phpinnacle/packages-dev",
    "description": "Development tooling for the PHPinnacle package monorepo.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "carthage-software/mago": "1.47.4",
        "composer/satis": "dev-main",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpinnacle/atlas": "*",
        "phpinnacle/babylon": "*",
        "phpinnacle/cabeiro": "*",
        "phpinnacle/canvio": "*",
        "phpinnacle/casus": "*",
        "phpinnacle/cerber": "*",
        "phpinnacle/chronica": "*",
        "phpinnacle/comments": "*",
        "phpinnacle/common": "*",
        "phpinnacle/dendros": "*",
        "phpinnacle/iconic": "*",
        "phpinnacle/intl": "*",
        "phpinnacle/langcat": "*",
        "phpinnacle/minos": "*",
        "phpinnacle/money": "*",
        "phpinnacle/openapi": "*",
        "phpinnacle/palette": "*",
        "phpinnacle/pinax": "*",
        "phpinnacle/recens": "*",
        "phpinnacle/rosetta": "*",
        "phpinnacle/sequentia": "*",
        "phpinnacle/settings": "*",
        "phpinnacle/signum": "*",
        "phpinnacle/skeleton": "*",
        "phpinnacle/stylus": "*",
        "phpinnacle/tags": "*",
        "phpinnacle/tempo": "*",
        "phpinnacle/vulcan": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": [
            "mago format --check",
            "mago lint --semantics"
        ],
        "format": "mago format",
        "test": "pest packages/*/tests"
    },
    "config": {
        "allow-plugins": {
            "composer/satis": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
