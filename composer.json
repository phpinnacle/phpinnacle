{
    "name": "phpinnacle/packages-dev",
    "description": "Development tooling for the PHPinnacle package monorepo.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "carthage-software/mago": "1.47.4",
        "composer/satis": "dev-main",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.1",
        "phpinnacle/atlas": "*",
        "phpinnacle/babylon": "*",
        "phpinnacle/cabeiro": "*",
        "phpinnacle/canvio": "*",
        "phpinnacle/casus": "*",
        "phpinnacle/cerber": "*",
        "phpinnacle/chronica": "*",
        "phpinnacle/comments": "*",
        "phpinnacle/common": "*",
        "phpinnacle/decima": "*",
        "phpinnacle/dendros": "*",
        "phpinnacle/eidos": "*",
        "phpinnacle/ferry": "*",
        "phpinnacle/franz": "*",
        "phpinnacle/grimoire": "*",
        "phpinnacle/iconic": "*",
        "phpinnacle/intl": "*",
        "phpinnacle/langcat": "*",
        "phpinnacle/manuscript": "*",
        "phpinnacle/midas": "*",
        "phpinnacle/money": "*",
        "phpinnacle/palette": "*",
        "phpinnacle/pinax": "*",
        "phpinnacle/porta": "*",
        "phpinnacle/razor": "*",
        "phpinnacle/recens": "*",
        "phpinnacle/rosetta": "*",
        "phpinnacle/sequentia": "*",
        "phpinnacle/settings": "*",
        "phpinnacle/signum": "*",
        "phpinnacle/stylus": "*",
        "phpinnacle/tags": "*",
        "phpinnacle/tempo": "*",
        "phpinnacle/vulcan": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "PHPinnacle\\Decima\\Tests\\": "packages/decima/tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "lint": [
            "mago format --check",
            "mago lint",
            "@phpstan",
            "@phpstan:level8",
            "@phpstan:level10"
        ],
        "format": "mago format",
        "phpstan": "phpstan analyse packages/*/src packages/chronica/tests/Unit/HasHistoryTest.php packages/common/tests/Unit/ConcernsTest.php packages/dendros/tests/Unit/TreeTest.php --no-progress --memory-limit=1G",
        "phpstan:level8": "phpstan analyse packages/cabeiro/src packages/vulcan/src --level=8 --no-progress --memory-limit=1G",
        "phpstan:level10": "phpstan analyse packages/babylon/src packages/canvio/src packages/casus/src packages/comments/src packages/ferry/src packages/franz/src packages/intl/src packages/langcat/src packages/rosetta/src packages/sequentia/src packages/tags/src --level=10 --no-progress --memory-limit=1G",
        "test": "pest $(find packages -mindepth 2 -maxdepth 2 -type d -name tests ! -path packages/skeleton/tests)"
    },
    "config": {
        "allow-plugins": {
            "composer/satis": true,
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
